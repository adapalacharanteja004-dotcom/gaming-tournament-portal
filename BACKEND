/* ================= GLOBAL ================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #050816;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    overflow-x: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
select {
    font-family: inherit;
}

button {
    cursor: pointer;
}


/* ================= NAVBAR ================= */

.navbar {
    width: 100%;
    height: 75px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 6%;

    background: rgba(5, 8, 22, 0.92);

    border-bottom: 1px solid #1d2745;

    position: sticky;
    top: 0;

    z-index: 1000;

    backdrop-filter: blur(15px);
}

.logo {
    font-family: 'Orbitron', sans-serif;

    font-size: 22px;
    font-weight: 800;

    color: white;
}

.logo span {
    color: #00e5ff;
}

.navbar nav {
    display: flex;
    gap: 28px;
}

.navbar nav a {
    color: #aeb8d0;

    font-size: 14px;

    transition: 0.3s;
}

.navbar nav a:hover {
    color: #00e5ff;
}

.nav-actions {
    display: flex;
    gap: 12px;
    align-items: center;
}

.notification-btn {
    background: transparent;
    color: white;

    border: none;

    font-size: 18px;

    position: relative;
}

.notification-btn span {
    position: absolute;

    top: -8px;
    right: -8px;

    background: #ff2d55;

    width: 18px;
    height: 18px;

    border-radius: 50%;

    font-size: 10px;

    display: flex;
    align-items: center;
    justify-content: center;
}

.login-btn {
    background: #00e5ff;

    border: none;

    padding: 10px 20px;

    border-radius: 7px;

    font-weight: 600;

    color: #001018;
}


/* ================= HERO ================= */

.hero {
    min-height: 700px;

    display: flex;
    align-items: center;

    padding: 100px 8%;

    position: relative;

    background:
        radial-gradient(circle at 80% 30%, #112c63 0%, transparent 35%),
        radial-gradient(circle at 20% 70%, #26104d 0%, transparent 35%),
        #050816;

    overflow: hidden;
}

.hero::before {
    content: "";

    position: absolute;

    width: 600px;
    height: 600px;

    border-radius: 50%;

    background: #00e5ff;

    filter: blur(180px);

    opacity: 0.08;

    right: -200px;
}

.hero-content {
    max-width: 850px;

    position: relative;

    z-index: 2;
}

.live-badge {
    display: inline-block;

    padding: 8px 15px;

    border: 1px solid #ff3155;

    background: #ff315515;

    color: #ff5575;

    border-radius: 30px;

    font-size: 12px;

    letter-spacing: 1px;

    margin-bottom: 25px;
}

.hero h1 {
    font-family: 'Orbitron', sans-serif;

    font-size: clamp(45px, 7vw, 90px);

    line-height: 1.05;

    margin-bottom: 25px;
}

.hero h1 span {
    display: block;

    color: transparent;

    -webkit-text-stroke: 2px #00e5ff;

    text-shadow: 0 0 25px #00e5ff55;
}

.hero p {
    max-width: 650px;

    color: #9da8c2;

    font-size: 17px;

    line-height: 1.8;

    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;
    gap: 15px;

    flex-wrap: wrap;
}

.primary-btn,
.secondary-btn {
    padding: 14px 25px;

    border-radius: 7px;

    font-weight: 600;

    border: none;
}

.primary-btn {
    background: linear-gradient(90deg, #00e5ff, #0077ff);

    color: white;

    box-shadow: 0 0 25px #00e5ff30;
}

.secondary-btn {
    background: transparent;

    border: 1px solid #34415f;

    color: white;
}

.secondary-btn:hover {
    border-color: #00e5ff;
}

.hero-stats {
    display: flex;

    gap: 50px;

    margin-top: 60px;

    flex-wrap: wrap;
}

.hero-stats div {
    display: flex;
    flex-direction: column;
}

.hero-stats strong {
    font-family: 'Orbitron', sans-serif;

    font-size: 25px;

    color: white;
}

.hero-stats span {
    color: #69748e;

    font-size: 12px;

    margin-top: 5px;
}


/* ================= SECTIONS ================= */

.section,
.live-section {
    padding: 90px 7%;
}

.dark-section {
    background: #080d1d;

    border-top: 1px solid #141d36;
    border-bottom: 1px solid #141d36;
}

.section-heading {
    display: flex;

    justify-content: space-between;
    align-items: center;

    margin-bottom: 40px;
}

.section-heading.center {
    justify-content: center;

    text-align: center;
}

.section-heading h2 {
    font-family: 'Orbitron', sans-serif;

    font-size: 30px;

    margin-top: 7px;
}

.section-heading > a {
    color: #00e5ff;

    font-size: 14px;
}

.section-label {
    color: #00e5ff;

    font-size: 11px;

    letter-spacing: 2px;
}


/* ================= LIVE MATCH ================= */

.live-section {
    background: #070b19;
}

.live-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 25px;
}

.live-card {
    background: linear-gradient(145deg, #101a32, #0b1124);

    border: 1px solid #1d2b4b;

    padding: 25px;

    border-radius: 12px;

    transition: 0.3s;
}

.live-card:hover {
    border-color: #00e5ff;

    transform: translateY(-4px);
}

.live-top {
    display: flex;

    justify-content: space-between;

    color: #71809f;

    font-size: 12px;

    margin-bottom: 15px;
}

.live-status {
    color: #ff3d61;
}

.live-card h3 {
    margin-bottom: 25px;
}

.teams {
    display: flex;

    align-items: center;
    justify-content: space-around;

    text-align: center;

    margin-bottom: 25px;
}

.team-logo {
    width: 55px;
    height: 55px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    font-size: 25px;

    margin: auto auto 10px;
}

.red {
    background: #ff315525;
}

.blue {
    background: #008cff25;
}

.yellow {
    background: #ffd00025;
}

.purple {
    background: #9c42ff25;
}

.team p {
    color: #8995ad;

    font-size: 12px;

    margin-bottom: 5px;
}

.team strong {
    font-family: 'Orbitron';

    font-size: 22px;
}

.vs {
    color: #53617b;

    font-family: 'Orbitron';

    font-size: 12px;
}

.live-card > button {
    width: 100%;

    background: #121e38;

    border: 1px solid #26385f;

    color: #00e5ff;

    padding: 11px;

    border-radius: 6px;
}


/* ================= FILTER ================= */

.filter-bar {
    display: flex;

    gap: 15px;

    margin-bottom: 30px;

    flex-wrap: wrap;
}

.filter-bar input,
.filter-bar select {
    background: #0d1529;

    color: white;

    border: 1px solid #243454;

    padding: 13px 16px;

    border-radius: 7px;

    outline: none;
}

.filter-bar input {
    flex: 1;

    min-width: 230px;
}

.filter-bar select {
    min-width: 160px;
}

.filter-bar input:focus,
.filter-bar select:focus {
    border-color: #00e5ff;
}


/* ================= TOURNAMENT ================= */

.tournament-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 20px;
}

.tournament-card {
    background: #0c1428;

    border: 1px solid #1d2b4b;

    border-radius: 10px;

    overflow: hidden;

    transition: 0.3s;
}

.tournament-card:hover {
    transform: translateY(-7px);

    border-color: #00e5ff;

    box-shadow: 0 15px 40px #0008;
}

.game-image {
    height: 170px;

    padding: 15px;

    display: flex;

    justify-content: space-between;

    align-items: flex-start;
}

.bgmi {
    background:
        linear-gradient(#0005, #0008),
        linear-gradient(135deg, #d77d00, #241500);
}

.valorant {
    background:
        linear-gradient(#0005, #0008),
        linear-gradient(135deg, #ff3155, #35000b);
}

.freefire {
    background:
        linear-gradient(#0005, #0008),
        linear-gradient(135deg, #ff7600, #321000);
}

.pubg {
    background:
        linear-gradient(#0005, #0008),
        linear-gradient(135deg, #ffbd00, #332500);
}

.game-tag,
.open-tag,
.upcoming-tag {
    font-size: 10px;

    padding: 6px 9px;

    border-radius: 4px;

    background: #0008;
}

.open-tag {
    color: #48ff9b;
}

.upcoming-tag {
    color: #ffc84a;
}

.tournament-content {
    padding: 20px;
}

.tournament-content h3 {
    font-size: 17px;

    margin-bottom: 8px;
}

.organizer {
    color: #687691;

    font-size: 11px;

    margin-bottom: 20px;
}

.tournament-info {
    display: flex;

    justify-content: space-between;

    border-top: 1px solid #1c2943;
    border-bottom: 1px solid #1c2943;

    padding: 14px 0;

    margin-bottom: 15px;
}

.tournament-info div {
    display: flex;

    flex-direction: column;
}

.tournament-info span {
    color: #64718b;

    font-size: 10px;
}

.tournament-info strong {
    margin-top: 5px;

    font-size: 13px;

    color: #00e5ff;
}

.tournament-date {
    color: #8793aa;

    font-size: 11px;

    margin-bottom: 15px;
}

.register-btn {
    width: 100%;

    padding: 11px;

    background: linear-gradient(90deg, #0077ff, #00cfff);

    border: none;

    border-radius: 5px;

    color: white;

    font-weight: 600;
}


/* ================= SCHEDULE ================= */

.schedule {
    max-width: 1000px;

    margin: auto;
}

.schedule-row {
    display: flex;

    align-items: center;

    gap: 25px;

    padding: 20px;

    background: #0d1529;

    border: 1px solid #1c2a48;

    border-radius: 10px;

    margin-bottom: 12px;
}

.date {
    width: 55px;

    text-align: center;

    display: flex;

    flex-direction: column;

    background: #121e38;

    padding: 8px;

    border-radius: 5px;
}

.date strong {
    font-size: 20px;

    color: #00e5ff;
}

.date span {
    font-size: 9px;

    color: #74819b;
}

.match-info {
    flex: 1;
}

.game-name {
    color: #00e5ff;

    font-size: 10px;

    text-transform: uppercase;
}

.match-info h3 {
    margin: 6px 0;

    font-size: 15px;
}

.match-info h3 b {
    color: #64718b;

    margin: 0 10px;
}

.match-info p {
    color: #687590;

    font-size: 11px;
}

.match-status {
    padding: 7px 12px;

    border-radius: 20px;

    font-size: 10px;
}

.upcoming {
    color: #ffc34d;

    background: #ffc34d15;
}


/* ================= LEADERBOARD ================= */

.leaderboard-container {
    max-width: 1000px;

    margin: auto;

    background: #0b1326;

    border: 1px solid #1d2b4b;

    border-radius: 10px;

    overflow: hidden;
}

.leaderboard-header,
.leader-row {
    display: grid;

    grid-template-columns: 70px 1fr 100px 100px 120px;

    align-items: center;

    padding: 16px 25px;
}

.leaderboard-header {
    background: #101b34;

    color: #697792;

    font-size: 11px;
}

.leader-row {
    border-top: 1px solid #17243e;

    transition: 0.3s;
}

.leader-row:hover {
    background: #101c35;
}

.rank {
    color: #78849c;

    font-family: 'Orbitron';

    font-size: 13px;
}

.gold {
    color: #ffd000;
}

.silver {
    color: #cbd5e1;
}

.bronze {
    color: #cd7f32;
}

.player {
    display: flex;

    align-items: center;

    gap: 12px;
}

.avatar {
    width: 38px;
    height: 38px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #15223d;

    border-radius: 50%;
}

.player div:last-child {
    display: flex;

    flex-direction: column;
}

.player strong {
    font-size: 13px;
}

.player small {
    color: #66738c;

    font-size: 10px;

    margin-top: 3px;
}

.points {
    color: #00e5ff;

    font-family: 'Orbitron';
}


/* ================= TEAMS ================= */

.create-team {
    padding: 10px 18px;

    background: #00e5ff;

    border: none;

    border-radius: 5px;

    color: #001018;

    font-weight: 600;
}

.team-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.team-card {
    text-align: center;

    background: #0c1428;

    border: 1px solid #1d2b4b;

    padding: 30px;

    border-radius: 10px;

    transition: 0.3s;
}

.team-card:hover {
    border-color: #00e5ff;

    transform: translateY(-5px);
}

.big-team-logo {
    width: 75px;
    height: 75px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: auto auto 15px;

    background: #13203b;

    border-radius: 50%;

    font-size: 35px;
}

.team-card h3 {
    font-family: 'Orbitron';

    font-size: 17px;
}

.team-card p {
    color: #687590;

    font-size: 12px;

    margin: 7px 0 20px;
}

.team-stats {
    display: flex;

    justify-content: center;

    gap: 20px;

    color: #8290a9;

    font-size: 10px;

    margin-bottom: 20px;
}

.team-card button {
    width: 100%;

    background: transparent;

    color: #00e5ff;

    border: 1px solid #243757;

    padding: 10px;

    border-radius: 5px;
}


/* ================= FEATURES ================= */

.features-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 20px;

    max-width: 1100px;

    margin: 40px auto 0;
}

.feature-card {
    background: #0b1326;

    border: 1px solid #1a2947;

    padding: 30px;

    border-radius: 10px;

    transition: 0.3s;
}

.feature-card:hover {
    border-color: #00e5ff;

    transform: translateY(-5px);
}

.feature-card > span {
    font-size: 35px;
}

.feature-card h3 {
    margin: 15px 0 8px;

    font-size: 16px;
}

.feature-card p {
    color: #71809b;

    font-size: 12px;

    line-height: 1.7;
}


/* ================= FOOTER ================= */

footer {
    background: #03050e;

    padding: 60px 7% 20px;
}

.footer-content {
    display: grid;

    grid-template-columns: 2fr 1fr 1fr;

    gap: 50px;

    padding-bottom: 40px;
}

.footer-content p {
    color: #65718a;

    font-size: 12px;

    max-width: 300px;

    line-height: 1.7;

    margin-top: 15px;
}

.footer-content h3 {
    font-size: 14px;

    margin-bottom: 15px;
}

.footer-content a {
    display: block;

    color: #65718a;

    font-size: 12px;

    margin: 10px 0;
}

.footer-content a:hover {
    color: #00e5ff;
}

.copyright {
    text-align: center;

    border-top: 1px solid #121b30;

    padding-top: 20px;

    color: #414c62;

    font-size: 11px;
}


/* ================= MODALS ================= */

.modal {
    position: fixed;

    inset: 0;

    background: #000000bb;

    backdrop-filter: blur(8px);

    display: none;

    align-items: center;
    justify-content: center;

    z-index: 2000;

    padding: 20px;
}

.modal.active {
    display: flex;
}

.modal-box {
    width: 400px;

    max-width: 100%;

    background: #0b1326;

    border: 1px solid #26395f;

    border-radius: 12px;

    padding: 35px;

    position: relative;

    text-align: center;

    box-shadow: 0 25px 100px #000;
}

.close {
    position: absolute;

    right: 15px;
    top: 10px;

    background: transparent;

    border: none;

    color: #77839c;

    font-size: 25px;
}

.modal-icon {
    font-size: 40px;

    margin-bottom: 10px;
}

.modal-box h2 {
    font-family: 'Orbitron';

    font-size: 22px;
}

.modal-box > p {
    color: #6f7c95;

    font-size: 12px;

    margin: 8px 0 25px;
}

.modal-box input {
    width: 100%;

    padding: 13px;

    margin-bottom: 12px;

    background: #101b33;

    border: 1px solid #263758;

    border-radius: 6px;

    outline: none;

    color: white;
}

.modal-box input:focus {
    border-color: #00e5ff;
}

.modal-btn {
    width: 100%;

    padding: 13px;

    border: none;

    border-radius: 6px;

    background: linear-gradient(90deg, #0077ff, #00e5ff);

    color: white;

    font-weight: 600;
}

.switch {
    margin-top: 20px !important;
}

.switch a {
    color: #00e5ff;
}


/* ================= NOTIFICATIONS ================= */

.notification-panel {
    position: fixed;

    right: 25px;
    top: 85px;

    width: 350px;

    background: #0b1326;

    border: 1px solid #263858;

    border-radius: 10px;

    box-shadow: 0 20px 70px #000;

    z-index: 1500;

    display: none;
}

.notification-panel.active {
    display: block;
}

.notification-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 18px;

    border-bottom: 1px solid #1c2942;
}

.notification-header h3 {
    font-size: 14px;
}

.notification-header button {
    background: transparent;

    color: #8490a7;

    border: none;

    font-size: 20px;
}

.notification {
    display: flex;

    gap: 12px;

    padding: 17px;

    border-bottom: 1px solid #16223a;
}

.notification > span {
    font-size: 20px;
}

.notification strong {
    font-size: 12px;
}

.notification p {
    color: #66748e;

    font-size: 10px;

    margin-top: 5px;

    line-height: 1.5;
}


/* ================= RESPONSIVE ================= */

@media (max-width: 1100px) {

    .tournament-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .features-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 800px) {

    .navbar {
        padding: 0 4%;
    }

    .navbar nav {
        display: none;
    }

    .live-grid {
        grid-template-columns: 1fr;
    }

    .team-grid {
        grid-template-columns: 1fr;
    }

    .features-grid {
        grid-template-columns: 1fr;
    }

    .footer-content {
        grid-template-columns: 1fr;
    }

    .leaderboard-header,
    .leader-row {
        grid-template-columns: 50px 1fr 60px 60px 80px;

        padding: 14px 10px;
    }

}

@media (max-width: 600px) {

    .hero {
        padding: 80px 6%;
    }

    .section,
    .live-section {
        padding: 60px 5%;
    }

    .tournament-grid {
        grid-template-columns: 1fr;
    }

    .hero-stats {
        gap: 25px;
    }

    .schedule-row {
        gap: 12px;
    }

    .match-status {
        display: none;
    }

    .leaderboard-header span:nth-child(3),
    .leader-row > span:nth-child(3),
    .leaderboard-header span:nth-child(4),
    .leader-row > span:nth-child(4) {
        display: none;
    }

    .leaderboard-header,
    .leader-row {
        grid-template-columns: 45px 1fr 80px;
    }

    .notification-panel {
        left: 10px;
        right: 10px;

        width: auto;
    }

}
